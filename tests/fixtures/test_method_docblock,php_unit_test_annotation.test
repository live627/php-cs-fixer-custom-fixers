	{
	}

	/**
	 * Other thing.
	 *
	 * Expected: Passes.
	 *
	 */
	public function testOtherThing(): void
	{
	}

	/**
	 * Yabba dabba doo.
	 *
	 * Expected: TODO describe the call and the assertion result.
	 */
	public function testYabba_dabba_doo(): void
	{
	}
}

