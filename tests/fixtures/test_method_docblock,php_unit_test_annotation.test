--TEST--
Integration of fixers: Live627/test_method_docblock,php_unit_test_annotation.
--RULESET--
{
    "Live627/test_method_docblock": true,
    "php_unit_test_annotation": {
        "style": "prefix"
    }
}
--CONFIG--
{
    "indent": "\t",
    "lineEnding": "\n",
    "customFixers": ["Live627\\PhpCsFixer\\CustomFixers\\TestMethodDocblockFixer"]
}
--SETTINGS--
{
    "isRiskyAllowed": true
}
--EXPECT--
